{
  "name": "rinklink-auth-service",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx src/ensure-auth-schema.ts && npm run auth:migrate && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/**/*.test.ts",
    "start": "npm run build && npm run start:compiled",
    "start:compiled": "node dist/ensure-auth-schema.js && npm run auth:migrate:compiled && node dist/index.js",
    "seed": "tsx src/seed.ts",
    "auth:generate": "npx @better-auth/cli generate --config ./src/auth.ts",
    "auth:migrate": "tsx src/migrate-auth-schema.ts",
    "auth:migrate:compiled": "node dist/migrate-auth-schema.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "better-auth": "^1.6.11",
    "dotenv": "^17.3.1",
    "hono": "^4.12.22",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
